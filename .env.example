# Copia este archivo a .env y completa tus proxies:
#   cp .env.example .env && chmod 600 .env
#
# Una variable por cuenta de WhatsApp: PROXY_1, PROXY_2, PROXY_3 ... (sin límite).
# Cada una es una URL SOCKS5 de un proxy ISP/residencial con IP FIJA.
#
#   PROXY_1="socks5://USUARIO:CLAVE@host-del-proveedor:PUERTO"
#
# Ejemplo con Decodo (el puerto elige la IP de salida):
#   PROXY_1="socks5://USUARIO:CLAVE@isp.decodo.com:10001"
#   PROXY_2="socks5://USUARIO:CLAVE@isp.decodo.com:10002"
#
# Reglas:
#   - Caracteres especiales en USUARIO y CLAVE deben ir codificados (URL-encoding):
#     @ -> %40   : -> %3A   / -> %2F   # -> %23   % -> %25   $ -> %24   espacio -> %20
#   - Deja las comillas dobles.
#   - Usa números consecutivos empezando en 1.
#   - NO compartas este archivo ni capturas que lo muestren.

PROXY_1=""
PROXY_2=""
PROXY_3=""

# Servicio que devuelve la IP de salida (HTTPS, puerto 443). Se usa en las sondas.
PROBE_HOST="api.ipify.org"
